# Cau hinh build vo iOS (thay cho file cfg.cmake ma Cocos Creator sinh ra)
set(CC_USE_METAL ON)
set(CC_USE_GLES3 OFF)
set(CC_USE_GLES2 OFF)
set(CC_USE_VULKAN OFF)
set(USE_PORTRAIT ON)
set(TARGET_IOS_VERSION "12.0")
set(CC_EXECUTABLE_NAME "")
set(CUSTOM_COPY_RESOURCE_HOOK OFF)
set(USE_V8_DEBUGGER OFF)
set(USE_WEBSOCKET_SERVER OFF)
# Xcode 16 / clang 17: engine 3.8.2 dung cu phap cu trong EventTarget.h
add_compile_options(-Wno-missing-template-arg-list-after-template-kw)
